DEBUG=True

# --- Password login (/token) ---
# Disabled unless all three are set. Generate the hash with src/notebooks/password_gen.ipynb.
# JWT_SECRET_KEY=<random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`>
# AUTH_USER=<user name>
# AUTH_PASSWORD_HASH=<bcrypt hash>

# --- CORS / CSRF: origins allowed to call the API (JSON list) ---
# ALLOWED_ORIGINS=["http://localhost:5173","https://qamposer.org"]

# --- IBM Quantum real hardware (users bring their own API key) ---
# IBM_ENABLED=true
# Key for encrypting stored API keys. Optional with the built-in in-memory session store
# (a random key is generated per process); required for a shared/persistent store.
# CREDENTIAL_ENCRYPTION_KEY=<python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())">
# IBM_SESSION_TTL_SECONDS=7200
# IBM_MAX_SHOTS=4096
# IBM_MAX_EXECUTION_TIME=<seconds of QPU time per job>
# IBM_SESSION_RATE_LIMIT_PER_MINUTE=5
# IBM_JOB_RATE_LIMIT_PER_HOUR=10
# Reverse proxies in front of the app (1 on Render), for the per-IP rate limit
# TRUSTED_PROXY_HOPS=0
# Secure cookies need HTTPS (http://localhost is treated as secure by browsers).
# COOKIE_SECURE=true
